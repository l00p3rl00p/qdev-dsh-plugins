{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@deepseek-ai/dsh-typert-protocol/remote-info": [
        "./node_modules/@deepseek-ai/dsh-typert-protocol/lib/types/remote-info"
      ]
    }
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/capabilities.ts"
  ]
}
