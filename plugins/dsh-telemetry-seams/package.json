{
  "name": "dsh-telemetry-seams",
  "version": "0.1.2",
  "description": "Native DeepSeek Harness Telemetry Seams inventory: discover, display, and health-check DSH and OTEL Collector telemetry interfaces without owning transport",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "telemetry",
    "otel",
    "observability"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-0 <0.3.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "eslint": "^10.14.0",
    "@typescript-eslint/parser": "^8.46.0",
    "zod": "^4.6.7",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5"
  },
  "pnpm": {
    "approvedBuilds": [
      "esbuild"
    ]
  },
  "scripts": {
    "prepare": "pnpm run build && pnpm run check:package",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:package",
    "check:package": "node ./scripts/check-package.mjs",
    "packcheck": "pnpm run build && mkdir -p dist && pnpm pack --pack-destination ./dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l00p3rl00p/qdev-dsh-plugins.git",
    "directory": "plugins/dsh-telemetry-seams"
  },
  "homepage": "https://github.com/l00p3rl00p/qdev-dsh-plugins/tree/main/plugins/dsh-telemetry-seams",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    }
  }
}
